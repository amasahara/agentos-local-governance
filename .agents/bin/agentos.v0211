#!/usr/bin/env sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/../.." && pwd)
CMD="${1:-}"
case "$CMD" in
  db-schema-snapshot-register|db-schema-snapshot-show|db-target-contract-create|db-target-contract-review|db-target-contract-approve|db-target-contract-show|db-field-mapping-add|db-field-mapping-confirm|db-field-mapping-reject|db-field-mapping-show|db-field-mapping-list|db-field-mapping-suggest|db-mapping-readiness|db-schema-mapping-db-sync)
    PYTHONPATH="$ROOT/.agents${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agentos.schema_mapping_cli --root "$ROOT" "$@"
    ;;
  docs-check)
    PYTHONPATH="$ROOT/.agents${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agentos.schema_mapping_cli --root "$ROOT" docs-check-v0211
    ;;
esac
exec "$HERE/agentos.v0210" "$@"
