{
  "governed_learning_policy": {
    "closed_loop": {
      "adverse_evaluation_statuses": [
        "negative",
        "mixed"
      ],
      "architecture_baseline_revalidation_required": true,
      "automatic_architecture_mutation": false,
      "automatic_policy_activation": false,
      "automatic_policy_proposal_creation": false,
      "automatic_policy_simulation_after_explicit_draft": true,
      "automatic_policy_transition": false,
      "automatic_skill_candidate_creation": true,
      "automatic_skill_graduation": false,
      "enabled": true,
      "evaluation_window_days": 30,
      "human_policy_transition_required": true,
      "human_skill_graduation_required": true,
      "mcp_mutation_allowed": false,
      "minimum_adverse_evaluations": 2,
      "minimum_distinct_evaluation_tasks": 2,
      "minimum_negative_evaluations": 1,
      "policy_activation_via_existing_evolution_only": true,
      "policy_patch_must_be_explicit": true,
      "skill_candidate_requires_learning_links": true,
      "source_signal_revalidation_required": true,
      "version": 1
    },
    "context": {
      "context_authority_hash_may_include_learning_evidence": false,
      "learning_derived_authority_class": "none",
      "learning_derived_instruction_authority": false,
      "learning_derived_knowledge_trust_class": "project_evidence",
      "learning_derived_knowledge_uses_existing_provenance": true,
      "learning_signal_context_source_registered": false,
      "learning_signals_directly_injected": false
    },
    "database_schema": 64,
    "degraded_safe": {
      "knowledge_usage_failure_must_be_surfaced": true,
      "knowledge_usage_failure_must_not_fabricate_usage": true,
      "knowledge_usage_savepoint_required": true,
      "learning_failure_must_not_weaken_governance": true,
      "ordinary_governed_execution_may_continue_without_learning": true
    },
    "effectiveness": {
      "actual_context_inclusion_required": true,
      "architecture_match_required": true,
      "automatic_deactivation_allowed": false,
      "automatic_review_request_creation": false,
      "automatic_stale_status_mutation": false,
      "automatic_supersede_allowed": false,
      "causal_effectiveness_claim_allowed": false,
      "comparative_effectiveness_enabled": true,
      "drift_detection_enabled": true,
      "explicit_review_request_required": true,
      "human_review_required_for_state_change": true,
      "mcp_mutation_allowed": false,
      "minimum_control_tasks": 5,
      "minimum_distinct_tasks": 5,
      "minimum_effect_size": 0.1,
      "minimum_treatment_tasks": 5,
      "provider_model_matching_required": true,
      "review_options": [
        "retain",
        "revise",
        "supersede",
        "deactivate"
      ],
      "significance_alpha": 0.05,
      "small_sample_warning_below": 30,
      "window_days": 90
    },
    "enabled": true,
    "mcp": {
      "mutation_allowed": false,
      "read_only": true,
      "tools": [
        "agentos.learning_signals_get",
        "agentos.learning_signal_links_get",
        "agentos.knowledge_usage_get",
        "agentos.learning_status_get"
      ]
    },
    "promotion": {
      "active_status": "active",
      "architecture_baseline_revalidation_required": true,
      "automatic_architecture_mutation": false,
      "automatic_memory_activation": false,
      "automatic_memory_authority_promotion": false,
      "automatic_memory_candidate_flagging": true,
      "automatic_policy_activation": false,
      "automatic_skill_graduation": false,
      "candidate_memory_kind": "procedural",
      "candidate_status": "candidate",
      "distinct_completed_tasks_required": true,
      "human_decision_required_for_memory_activation": true,
      "minimum_distinct_tasks": 2,
      "minimum_occurrences": 3,
      "promotion_cooldown_days": 7,
      "rejected_status": "rejected",
      "source_signal_revalidation_required": true,
      "window_days": 30
    },
    "retention": {
      "automatic_archive_enabled": false,
      "canonical_signal_deletion_allowed": false,
      "max_active_signals_per_signature": 50,
      "retrieval_max_age_days": 90
    },
    "scope": "agentos_governed_learning_evidence_linkage",
    "signal_creation": {
      "completed_task_required_for_cross_task_learning": true,
      "per_task_monotonic_sequence_required": true,
      "raw_content_duplication_allowed": false,
      "same_active_session_context_reuse_allowed": false,
      "source_hash_pin_required": true,
      "transactional_sequence_assignment_required": true,
      "verification_required_for_verification_signals": true
    },
    "version": 1
  }
}
