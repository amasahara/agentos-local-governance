{
  "database_boundary_policy": {
    "boundary_version": 1,
    "exactly_one_target_per_consolidation": true,
    "one_or_more_sources_supported": true,
    "source_role_is_immutable_within_consolidation": true,
    "target_role_is_immutable_within_consolidation": true,
    "source_catalog_read_allowed": true,
    "source_select_allowed": true,
    "source_insert_allowed": false,
    "source_update_allowed": false,
    "source_delete_allowed": false,
