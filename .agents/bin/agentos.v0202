#!/usr/bin/env sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/../.." && pwd)
CMD="${1:-}"
case "$CMD" in
  project-consolidation-create|project-consolidation-show|project-consolidation-add|project-consolidation-remove|project-consolidation-review|project-consolidation-approve|project-consolidation-execute|project-consolidation-complete|project-consolidation-rollback|project-consolidation-db-sync)
    PYTHONPATH="$ROOT/.agents${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agentos.project_consolidation_cli --root "$ROOT" "$@"
    ;;
  docs-check)
    PYTHONPATH="$ROOT/.agents${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agentos.project_consolidation_cli --root "$ROOT" docs-check-v0202
    ;;
esac
exec "$HERE/agentos.v0201" "$@"
