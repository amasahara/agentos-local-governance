    "human_acknowledgement_command": "ack-baseline",
    "agent_must_not_ack_for_user": true,
    "recursive_tracking": true,
    "report_blocks_uninitialized_baseline": true,
    "report_blocks_drift": true,
    "interactive_human_ack_default": true,
    "tracked_paths": [
      "AGENTS.md",
      "README.md",
      "huong_dan.md",
      "VERSION",
      ".agents/config/**/*.json",
      ".agents/agentos/**/*.py",
      ".agents/bin/**",
      ".agents/docs/**/*.md",
      ".agents/skills/**"
    ],
    "excluded_paths": [
      ".agents/runtime/**",
      ".agents/state/**",
      ".agents/cache/**",
      "**/__pycache__/**",
      "**/*.pyc"
