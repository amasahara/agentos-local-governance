{
  "version": "0.19.5",
  "language_policy": {
    "understand_user_language_directly": true,
    "preserve_original_request": true,
    "external_translation_for_intent_parsing": "forbidden",
    "response_language": "user_language",
    "technical_identifiers_language": "english"
  },
  "instruction_policy": {
    "single_source": "AGENTS.md",
    "forbid_model_specific_instruction_files": true
  },
  "filesystem_policy": {
    "project_root_containment": true,
    "deny_path_traversal": true,
    "deny_symlink_escape": true,
    "require_task_approval": true,
    "require_approved_scope": true
  },
  "claim_policy": {
    "enabled": true,
    "claim_types": [
      "business_logic",
      "security",
      "data_behavior",
      "destructive_effect",
      "governance",
      "other"
    ],
    "risk_levels": [
      "low",
      "medium",
      "high"
    ],
    "require_evidence_for_high_risk": true,
    "require_evidence_for_medium_types": [
      "business_logic",
      "security",
      "data_behavior",
      "destructive_effect"
    ],
    "default_evidence_classification": "local",
    "allow_network_evidence": false,
    "require_successful_evidence": true,
    "require_same_task_evidence": true
  },
  "workflows": {
    "default": [
      "receive_request",
      "assess_requirement_clarity",
      "clarify_if_needed",
      "approve_task",
      "detect_environment",
      "build_or_update_local_index",
      "prepare_change",
      "execute_guarded",
      "documentation_check",
      "tests",
      "evidence_review",
      "egress_review",
      "structural_review",
      "synchronize",
      "report"
    ],
    "governance_change": [
      "classify_governance_change",
      "identify_authoritative_files",
      "assess_compatibility",
      "update_instruction",
      "update_structured_policy",
      "update_runtime",
      "update_tests",
      "update_bilingual_docs",
      "append_changelog",
      "bump_version",
      "run_checks",
      "report_matrix"
    ]
  },
  "task_context_policy": {
    "persist_current_task": true,
    "context_reminder_on_every_cli_command": true,
    "allow_implicit_current_task": true,
    "require_explicit_use_task_for_resume": false,
    "session_scoped_current_task": true,
    "default_session_from_env": "AGENTOS_SESSION_ID"
  },
  "workflow_policy": {
    "persist_steps": true,
    "require_skip_reason": true,
    "report_requires_complete_workflow": true,
    "failure_exit_code": 2,
    "automated_steps_require_command_provenance": true,
    "manual_done_for_automated_steps_forbidden": true
  },
  "drift_policy": {
    "enabled": true,
    "tracked_files": [
      "AGENTS.md",
      ".agents/config/governance.json",
      "VERSION",
      ".agents/agentos/*.py",
      ".agents/config/governance.local.json"
    ],
    "human_acknowledgement_command": "ack-baseline",
    "agent_must_not_ack_for_user": true,
    "recursive_tracking": true,
    "report_blocks_uninitialized_baseline": true,
    "report_blocks_drift": true,
    "interactive_human_ack_default": true,
    "tracked_paths": [
      "AGENTS.md",
      "README.md",
      "huong_dan.md",
      "VERSION",
      ".agents/config/**/*.json",
      ".agents/agentos/**/*.py",
      ".agents/bin/**",
      ".agents/docs/**/*.md",
      ".agents/skills/**"
    ],
    "excluded_paths": [
      ".agents/runtime/**",
      ".agents/state/**",
      ".agents/cache/**",
      "**/__pycache__/**",
      "**/*.pyc"
    ]
  },
  "installation_policy": {
    "never_overwrite_existing_root_files": true,
    "fallback_suffix": ".agentos",
    "support_local_policy_override": true,
    "git_hook_optional": true,
    "automatic_baseline_acknowledgement": false
  },
  "tool_policy": {
    "canonical_guarded_lifecycle": true,
    "derive_classification_from_registry": true,
    "unknown_tools_fail_closed": true,
    "execution_token_ttl_seconds": 900,
    "direct_record_tool_forbidden": true,
    "redact_audit_content": true,
    "proxy_only_mode": true,
    "legacy_guarded_execution_enabled": false
  },
  "local_override_policy": {
    "safe_keys": [
      "source_root",
      "test_path",
      "encoding",
      "runtime_paths"
    ],
    "sensitive_sections": [
      "claim_policy",
      "filesystem_policy",
      "tool_policy",
      "workflow_policy",
      "drift_policy",
      "instruction_policy",
      "task_context_policy"
    ],
    "sensitive_override_requires_approval": true
  },
  "proxy_policy": {
    "enabled": true,
    "mcp_gateway": true,
    "direct_backend_access_forbidden": true,
    "block_on_uninitialized_baseline": true,
    "block_on_drift": true,
    "capabilities": [
      "filesystem.read",
      "filesystem.write",
      "process.exec",
      "network.http"
    ],
    "shell_mode": "argv_only_no_shell",
    "http_max_response_bytes": 1048576,
    "process_exec": {
      "enabled": true,
      "allowed_executables": [
        "python",
        "python3",
        "pytest",
        "ruff",
        "mypy",
        "node",
        "npm"
      ],
      "denied_executables": [
        "curl",
        "wget",
        "nc",
        "netcat",
        "ssh",
        "scp",
        "sftp",
        "ftp",
        "bash",
        "sh",
        "zsh",
        "powershell",
        "pwsh",
        "cmd"
      ],
      "deny_inline_code": true,
      "allowed_python_modules": [
        "pytest",
        "unittest",
        "compileall"
      ],
      "allowed_npm_commands": [
        "test",
        "run"
      ],
      "require_known_command_profile": true,
      "cwd_must_be_inside_project": true,
      "filtered_environment": true,
      "max_timeout_seconds": 600,
      "max_output_bytes": 65536
    },
    "network_http": {
      "default": "deny",
      "allowed_domains": [],
      "allowed_schemes": [
        "https"
      ],
      "allow_subdomains": false,
      "blocked_private_networks": true,
      "blocked_loopback": true,
      "blocked_link_local": true,
      "max_redirects": 3
    }
  },
  "external_audit_policy": {
    "enabled": true,
    "storage": "external_jsonl",
    "default_home": "~/.agentos/audit",
    "signature_algorithm": "Ed25519",
    "hash_chain": true,
    "fail_closed_for": [
      "filesystem.write",
      "process.exec",
      "network.http"
    ],
    "verify_before_report": true,
    "private_key_outside_repository": true,
    "key_registry": true,
    "key_rotation": true,
    "sink_modes": [
      "jsonl",
      "daemon",
      "remote_http"
    ],
    "default_sink_mode": "jsonl",
    "multi_process_mode": true,
    "required_sink_for_multi_process": "daemon",
    "direct_jsonl_append_recommended": false
  },
  "documentation_policy": {
    "current_version_files": [
      "README.md",
      "huong_dan.md",
      "AGENTS.md"
    ],
    "current_schema": 31,
    "history_begin": "AGENTOS_VERSION_HISTORY_BEGIN",
    "history_end": "AGENTOS_VERSION_HISTORY_END"
  },
  "concurrency_policy": {
    "enabled": true,
    "session_isolation": true,
    "task_single_writer": true,
    "default_write_lease_seconds": 300,
    "max_lease_seconds": 3600,
    "heartbeat_interval_seconds": 30,
    "expired_lease_grace_seconds": 60,
    "file_write_requires_lease": true,
    "file_write_requires_expected_hash": true,
    "atomic_replace": true,
    "exact_file_scope_conflict": "block",
    "directory_scope_conflict": "warn",
    "symbol_leases": false,
    "audit_sink_for_multi_process": "daemon",
    "coordination_via_proxy_only": true,
    "signed_coordination_audit": true,
    "task_stale_after_seconds": 120,
    "write_lease_requires_approved_scope": true,
    "force_reclaim_requires_stale": true
  },
  "security_program": {
    "releases": [
      "0.13.1",
      "0.14.0",
      "0.14.1",
      "0.14.2",
      "0.14.3"
    ],
    "gateway_required": true,
    "authenticated_capability_sessions": true,
    "isolated_execution": true,
    "verifiable_state_recovery": true,
    "security_profile": "advisory"
  },
  "knowledge_runtime": {
    "context_runtime": {
      "enabled": true,
      "deterministic": true,
      "default_max_lines": 500,
      "stale_source_detection": true,
      "llm_summarization": "forbidden",
      "compaction_mode": "symbol_window",
      "compaction_mode_allowed": [
        "flat_lines",
        "symbol_window"
      ],
      "global_max_lines": 500,
      "global_max_approx_tokens": 12000,
      "per_file_max_lines": 160,
      "report_omitted_context": true,
      "shadow_compare_modes": false,
      "relevance_scoring": true,
      "include_knowledge": true,
      "mandatory_min_tokens": 3000,
      "knowledge_reserved_tokens": 1000,
      "supporting_max_tokens": 8000,
      "semantic_fallback_threshold": 10.0,
      "report_omitted_knowledge": true
    },
    "project_memory": {
      "enabled": true,
      "kinds": [
        "semantic",
        "episodic",
        "procedural",
        "evidence"
      ],
      "provenance_required": true,
      "stale_source_invalidation": true,
      "finding_deduplication": true,
      "user_memory_ttl_days": 180,
      "global_user_profile_enabled": false,
      "require_explicit_consent": true
    },
    "skill_policy": {
      "enabled": true,
      "candidate_confidence_threshold": 0.8,
      "graduation_requires_human_approval": true,
      "candidate_auto_activation": false,
      "graduated_skills_only_in_context": true,
      "executable_skills": "forbidden"
    },
    "retrieval": {
      "enabled": true,
      "default_backend": "lexical_structured",
      "allowed_backends": [
        "lexical_structured",
        "local_feature_hash_v1"
      ],
      "sources": [
        "memory",
        "finding",
        "symbol",
        "skill"
      ],
      "network": "forbidden",
      "llm": "forbidden",
      "backend_interface_stable": true,
      "optional_embeddings": true,
      "embedding_backend": "local_feature_hash_v1",
      "rag_enabled": true,
      "auto_index": true,
      "external_model_download": "forbidden"
    },
    "relationship_graph": {
      "enabled": true,
      "scope": "use_case_driven",
      "use_cases": [
        "impact_analysis",
        "finding_to_symbol",
        "skill_provenance"
      ],
      "general_purpose_graph": "forbidden",
      "max_path_depth": 4,
      "evidence_required": true
    }
  },
  "execution_platform": {
    "async_jobs": true,
    "workflow_aware_tool_discovery": true,
    "immutable_job_specs": true,
    "versioned_task_plans": true,
    "git_precommit_gate": true,
    "evaluation_harness": true,
    "metrics_schema_version": 1
  },
  "evolution_policy": {
    "enabled": true,
    "evaluation_baseline_required": true,
    "human_activation_required": true,
    "stages": [
      "draft",
      "simulated",
      "reviewed",
      "shadow",
      "canary",
      "active",
      "rolled_back"
    ],
    "automatic_activation": false
  },
  "multi_agent_policy": {
    "enabled": true,
    "require_capability_sessions": true,
    "require_active_roles": true,
    "require_fresh_context_pack": true,
    "disclosure_levels": [
      "metadata-only",
      "summary",
      "selected-artifacts",
      "full-task-context"
    ],
    "signed_messages": true,
    "enforce_disclosure_payload_filtering": true
  },
  "knowledge_runtime_fixes": {
    "filesystem_read_cache_integration": true,
    "structured_clarity_assessment": true,
    "context_candidate_reporting": true
  },
  "evaluation_policy": {
    "outcomes_optional": true,
    "minimum_comparison_sample": 30,
    "confidence_level": 0.95
  },
  "storage_policy": {
    "retrieval_event_retention_days": 30,
    "workspace_retention_hours": 24,
    "audit_segment_size": 10000,
    "embedding_storage": "blob_float32",
    "backup_include_rebuildable": false
  }
}
