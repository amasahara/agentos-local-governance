# Python
__pycache__/
*.py[cod]
.pytest_cache/

# AgentOS ephemeral runtime
.agents/runtime/*
!.agents/runtime/.gitkeep

.agents/cache/*
!.agents/cache/.gitkeep

# Local AgentOS state
.agents/state/*
!.agents/state/.gitkeep

# Local secrets / keys
*.key
*.pem
*.secret

# Local upgrade/recovery
.agentos-upgrade-backups/
.agents/runtime/upgrade-backups/
.agents/runtime/hotfixes/

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Generated release / hotfix artifacts
/HOTFIX_INFO.txt
/apply_v*.py.sha256
/CHECKSUMS_V*.sha256
/VALIDATION_REPORT_V*.json
/*.zip
/*.zip.sha256

# Coverage / test outputs
.coverage
coverage.xml
htmlcov/

# Temporary files
*.tmp
*.bak
*.log