      "deny_inline_code": true,
      "allowed_python_modules": [
        "pytest",
        "unittest",
        "compileall"
      ],
      "allowed_npm_commands": [
        "test",
        "run"
      ],
      "require_known_command_profile": true,
      "cwd_must_be_inside_project": true,
      "filtered_environment": true,
      "max_timeout_seconds": 600,
      "max_output_bytes": 65536
