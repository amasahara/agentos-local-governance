    "source_ddl_allowed": false,
    "source_stored_procedure_side_effect_allowed": false,
    "source_readonly_verification_required": true,
    "readonly_verification_write_probe_forbidden": true,
    "raw_credentials_in_repository_forbidden": true,
    "credential_reference_required": true,
    "tls_required": true,
    "supported_engines": ["mysql", "mssql", "postgresql", "oracle"],
    "source_target_domain_match_required": true,
    "connection_cannot_be_source_and_target_same_plan": true,
    "target_schema_contract_required_before_data_write": true,
