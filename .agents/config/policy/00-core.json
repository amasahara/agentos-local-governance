{
  "version": "0.29.1",
  "schema_version": 62,
  "repository_policy": {
    "roles": [
      "agentos_distribution",
      "governed_project"
    ],
    "authoritative_distribution_metadata": ".agents/distribution/metadata.json",
    "installed_metadata_root": ".agents/release",
    "application_root_metadata_owned_by_agentos": false
  },
  "runtime_policy": {
    "cli_entrypoint": "agentos.cli_runtime",
    "mcp_entrypoint": "agentos.mcp_runtime",
    "historical_version_forwarding": false,
    "privileged_cli_entrypoint": "agentos.privileged_control_plane",
    "agent_launcher": "agentos",
    "privileged_control_plane_launcher": "agentos-admin",
    "separated_control_plane_required": true,
    "agent_plane_privileged_execution_allowed": false,
    "control_plane_allowlist_explicit": true,
    "dual_plane_argument_enforcement": true
  }
}
