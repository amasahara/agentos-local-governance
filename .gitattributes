# AgentOS cross-platform release byte policy.
# Release manifests/checksums hash filesystem bytes, so textual files must have
# deterministic checkout line endings on Windows, Linux, and macOS.

*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.sha256 text eol=lf
*.sh text eol=lf

VERSION text eol=lf
AGENTS.md text eol=lf
.agents/bin/agentos text eol=lf
.agents/bin/agentos-mcp text eol=lf
.agents/bin/hooks/* text eol=lf

# Windows launchers intentionally use CRLF.
*.cmd text eol=crlf
