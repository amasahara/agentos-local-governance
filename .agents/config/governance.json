  "workflow_policy": {
    "persist_steps": true,
    "require_skip_reason": true,
    "report_requires_complete_workflow": true,
    "failure_exit_code": 2,
    "automated_steps_require_command_provenance": true,
    "manual_done_for_automated_steps_forbidden": true
