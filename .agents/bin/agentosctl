#!/usr/bin/env python3
"""Operator control plane for AgentOS security operations."""
from pathlib import Path
import argparse,json,sys
sys.path.insert(0,str(Path(__file__).resolve().parents[1]))
from agentos.gateway_client import request

def main():
    p=argparse.ArgumentParser(); p.add_argument('--root',default='.')
    sub=p.add_subparsers(dest='cmd',required=True)
    x=sub.add_parser('health')
    x=sub.add_parser('issue-session'); x.add_argument('--task-id',required=True); x.add_argument('--session-id',required=True); x.add_argument('--ttl',type=int,default=900)
    x=sub.add_parser('revoke-session'); x.add_argument('--token-id',required=True); x.add_argument('--identity',required=True); x.add_argument('--reason',required=True)
    sub.add_parser('reconcile')
    a=p.parse_args(); root=Path(a.root).resolve()
    payload={'action':a.cmd.replace('-','_')}
    if a.cmd=='issue-session': payload.update(task_id=a.task_id,session_id=a.session_id,ttl_seconds=a.ttl)
    if a.cmd=='revoke-session': payload.update(token_id=a.token_id,revoked_by=a.identity,reason=a.reason)
    print(json.dumps(request(root,payload),ensure_ascii=False,indent=2))
if __name__=='__main__': main()
