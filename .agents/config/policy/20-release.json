    "windows_ci_activation_suite_required": true,
    "sandbox_configuration_contract_enabled": true,
    "sandbox_configuration_version": 1,
    "sandbox_configuration_source": "effective_policy",
    "sandbox_configuration_hash_required": true,
    "configured_profiles_must_match_known_profiles": true,
    "unknown_profile_fields_allowed": false,
    "security_invariants_runtime_enforced": true,
