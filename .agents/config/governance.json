  "workflows": {
    "default": [
      "receive_request",
      "assess_requirement_clarity",
      "clarify_if_needed",
      "approve_task",
      "detect_environment",
      "build_or_update_local_index",
      "prepare_change",
      "execute_guarded",
      "documentation_check",
      "tests",
      "evidence_review",
      "egress_review",
      "structural_review",
      "synchronize",
      "report"
    ],
    "governance_change": [
      "classify_governance_change",
      "identify_authoritative_files",
      "assess_compatibility",
      "update_instruction",
      "update_structured_policy",
      "update_runtime",
      "update_tests",
      "update_bilingual_docs",
      "append_changelog",
      "bump_version",
      "run_checks",
      "report_matrix"
