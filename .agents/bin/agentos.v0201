#!/usr/bin/env sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT=$(CDPATH= cd -- "$HERE/../.." && pwd)
CMD="${1:-}"
case "$CMD" in
  project-candidate-set-create|project-candidate-set-show|project-compatibility-show|project-compatibility-confirm|project-primary-recommend|project-primary-select|project-primary-status|project-selection-db-sync)
    PYTHONPATH="$ROOT/.agents${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agentos.project_selection_cli --root "$ROOT" "$@"
    ;;
  docs-check)
    PYTHONPATH="$ROOT/.agents${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agentos.project_selection_cli --root "$ROOT" docs-check-v0201
    ;;
esac
exec "$HERE/agentos.v0200" "$@"
