{
  "read_only_extraction_policy": {
    "extraction_version": 1,
    "database_schema": 37,
    "source_readonly_verification_required": true,
    "source_select_only": true,
    "source_write_allowed": false,
    "select_star_allowed": false,
    "arbitrary_sql_allowed": false,
    "only_confirmed_current_mappings_selectable": true,
    "source_snapshot_hash_revalidation_required": true,
    "target_contract_hash_revalidation_required": true,
    "mapping_hash_revalidation_required": true,
    "required_target_fields_must_be_mapped_per_batch": true,
    "built_in_transform_allowlist_required": true,
    "dynamic_eval_transform_forbidden": true,
    "validation_before_staging_required": true,
    "invalid_rows_quarantined": true,
    "raw_quarantine_values_stored": false,
    "raw_record_values_in_sqlite_forbidden": true,
    "raw_record_values_in_audit_forbidden": true,
    "staging_local_only": true,
    "staging_git_ignored_required": true,
    "staging_file_mode": "0600",
    "staging_integrity_hash_required": true,
    "staging_manifest_required": true,
    "target_data_write_enabled": false,
    "target_insert_available_from_version": "0.22.0",
    "mcp_may_run_extraction": false,
    "mcp_may_read_staging_content": false,
    "mcp_may_read_validation_summary": true,
    "mcp_may_read_value_hash_findings": true,
    "default_secret_resolver": "env_json_only",
    "external_secret_resolver_injection_allowed": true,
    "supported_engines": ["mysql", "mssql", "postgresql", "oracle"]
  }
}
