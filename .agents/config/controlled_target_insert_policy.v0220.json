{
  "controlled_target_insert_policy": {
    "insert_version": 1,
    "database_schema": 38,
    "controlled_insert_enabled": true,
    "raw_target_insert_allowed": false,
    "arbitrary_sql_allowed": false,
    "source_write_allowed": false,
    "source_readonly_invariant_rechecked_before_write": true,
    "exactly_one_target_required": true,
    "target_role_required": "TARGET",
    "target_connection_active_required": true,
    "validated_extraction_batch_required": true,
    "partial_batch_with_rejections_allowed": false,
    "staging_integrity_revalidation_required": true,
    "approved_target_contract_required": true,
    "target_snapshot_hash_revalidation_required": true,
    "mapping_set_hash_revalidation_required": true,
    "extraction_plan_hash_revalidation_required": true,
    "insert_plan_immutable": true,
    "human_review_required": true,
    "human_approval_required": true,
    "approval_bound_to_insert_plan_hash": true,
    "write_mode": "INSERT_ONLY",
    "update_allowed": false,
    "upsert_allowed": false,
    "merge_allowed": false,
    "delete_allowed": false,
    "ddl_allowed": false,
    "prepared_statements_required": true,
    "single_external_transaction_required": true,
    "precommit_failure_requires_rollback": true,
    "commit_uncertainty_status": "in_doubt",
    "automatic_retry_after_commit_uncertainty": false,
    "one_insert_run_per_extraction_batch": true,
    "row_values_in_sqlite_forbidden": true,
    "row_values_in_audit_forbidden": true,
    "credential_ref_only": true,
    "default_secret_resolver": "env_json_only",
    "mcp_read_only": true,
    "mcp_may_execute_insert": false,
    "mcp_may_review_or_approve": false,
    "mcp_may_read_insert_plan": true,
    "mcp_may_read_receipt": true,
    "supported_engines": [
      "mysql",
      "mssql",
      "postgresql",
      "oracle"
    ],
    "next_identity_resolution_version": "0.22.1"
  }
}
